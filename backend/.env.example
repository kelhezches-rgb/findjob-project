DATABASE_URL="postgresql://postgres:password@localhost:5432/jobboard"
JWT_SECRET="replace-with-64-char-random-string"
JWT_REFRESH_SECRET="replace-with-another-64-char-random-string"
PORT=5000
CLIENT_URL="http://localhost:3000"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
NODE_ENV=development

# Email / SMTP (Nodemailer)
# Development: leave blank — Ethereal test account auto-created, preview URL logged to console
# Production: fill in your SMTP provider credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="JobBoard" <noreply@jobboard.com>
